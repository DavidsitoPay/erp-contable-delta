# .env.example — Delta ERP Contable
# Copiar como ".env" y ajustar valores reales antes de un despliegue distinto al local.
# Nota: devops/docker-compose.yml usa estos mismos valores como default embebido
# por ahora (no lee este archivo automáticamente); se deja documentado aquí para
# quien despliegue el proyecto sepa qué configurar, y como paso siguiente hacia
# externalizar secretos fuera del repositorio (Azure Key Vault / variables de la
# pipeline en DevOps 2).

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=delta_erp
POSTGRES_USER=delta_app
POSTGRES_PASSWORD=changeme_local_only

# --- Backend (ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=db;Database=delta_erp;Username=delta_app;Password=changeme_local_only

# --- JWT (M8 Seguridad) ---
# Generar una clave nueva y secreta para cualquier ambiente distinto de desarrollo local.
Jwt__Issuer=DeltaERP
Jwt__Audience=DeltaERP
Jwt__Key=dev_only_change_before_prod
Jwt__ExpirationMinutes=60

# --- Frontend (React / Vite) ---
VITE_API_URL=http://localhost:5000/api
